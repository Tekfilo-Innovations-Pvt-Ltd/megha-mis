# ERP tenant database — the only database MIS uses, READ-ONLY. devmegha is
# only the master/tenant registry; ERP data lives in a per-tenant database
# (e.g. tenantb8278d), schema public. URL-encode special characters in the
# password ("#" -> %23). Prefer the mis_readonly role from the README.
# connection_limit / pool_timeout (seconds): Prisma's pool to the ERP server —
# its default (CPU count × 2 + 1, 10 s wait) timed out under parallel queries.
DATABASE_URL="postgresql://mis_readonly:CHANGE_ME@13.127.119.227:5432/tenantb8278d?schema=public&application_name=megha-mis&connection_limit=20&pool_timeout=30"

NEXTAUTH_SECRET="generate-a-random-secret-here"
NEXTAUTH_URL="http://localhost:3001"

# Optional common MIS-only login, VIEW ONLY, every company with factory
# invoices (src/lib/sharedLogin.ts). Don't type these by hand — run:
#   npx tsx scripts/set-shared-login.ts mis-viewer [password] [--name "MIS Viewer"]
# MIS_SHARED_USERNAME=mis-viewer
# MIS_SHARED_PASSWORD_HASH=scrypt:16384:8:1:<salt>:<hash>
# MIS_SHARED_NAME=MIS Viewer
